GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TRIAGE_CONCURRENCY=4
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=30

# Optional Google Sheets export
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Requests
GOOGLE_SERVICE_ACCOUNT_FILE=
# Or provide the complete service-account JSON in one environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Telegram digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Explicit opt-in for tests that make real external API calls.
RUN_LIVE_INTEGRATION_TESTS=0
